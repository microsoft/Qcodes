{
    "type": "object",
    "title": "QCoDeS Station configuration validation",
    "description": "This schema serves the purpose of validating yaml files that describe a QCoDeS station. See more here: https://qcodes.github.io/Qcodes/examples/Station.html#Configuring-the-Station-by-using-a-YAML-configuration-file",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "instruments": {
            "enum": [
                ""
            ]
        },
        "parameter_base": {
            "$comment": "A common base for the properties shared by 'add_parameters' and 'parameters' can first be implemented with the new json-schema draft 2019-09, for which there is no implementation at this point. The new feature is called 'unevaluatedProperties'."
        },
        "parameter_settings": {
            "$comment": "Settings applied to an existing parameter: a mapping of parameter attributes such as 'initial_value', 'label', 'unit', 'limits'. Used both in the 'parameters' section and when configuring parameters nested under a submodule or channel list/tuple.",
            "type": "object",
            "properties": {
                "alias": {
                    "type": "string",
                    "pattern": "^\\w+$"
                },
                "label": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
                },
                "scale": {
                    "type": "number"
                },
                "post_delay": {
                    "type": "number"
                },
                "inter_delay": {
                    "type": "number"
                },
                "step": {
                    "type": "number"
                },
                "offset": {
                    "type": "number"
                },
                "limits": {
                    "type": [
                        "array",
                        "string"
                    ],
                    "items": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "number"
                        }
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "additionalItems": false
                },
                "initial_value": {},
                "monitor": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "component_settings": {
            "$comment": "Settings for a submodule or channel list/tuple of an instrument. Each key is the name of either a parameter (mapped to its settings, see 'parameter_settings') or a nested submodule/channel list/tuple (mapped to another 'component_settings' object).",
            "type": "object",
            "additionalProperties": {
                "anyOf": [
                    {
                        "$ref": "#/definitions/parameter_settings"
                    },
                    {
                        "$ref": "#/definitions/component_settings"
                    }
                ]
            }
        }
    },
    "properties": {
        "instruments": {
            "description": "Instruments defined in this file. Valid names are all alphanumerical names including '_'.",
            "type": "object",
            "patternProperties": {
                "^\\w+$": {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "type": "string",
                            "anyOf": [
                                {
                                    "pattern": "^(\\w+)(\\.\\w+)*$"
                                },
                                {
                                    "$ref": "#/definitions/instruments"
                                }
                            ]
                        },
                        "driver": {
                            "type": "string",
                            "description": "Deprecated. Append 'driver'-value to 'type' field instead."
                        },
                        "address": {
                            "type": "string"
                        },
                        "port": {
                            "type": "integer"
                        },
                        "enable_forced_reconnect": {
                            "type": "boolean"
                        },
                        "init": {
                            "type": "object"
                        },
                        "add_parameters": {
                            "type": "object",
                            "patternProperties": {
                                "^(\\w+)(\\.\\w+)*$": {
                                    "type": "object",
                                    "properties": {
                                        "source": {
                                            "type": "string",
                                            "pattern": "^(\\w+(\\[\\d+\\])*)(\\.\\w+(\\[\\d+\\])*)*$"
                                        },
                                        "label": {
                                            "type": "string"
                                        },
                                        "unit": {
                                            "type": "string"
                                        },
                                        "scale": {
                                            "type": "number"
                                        },
                                        "post_delay": {
                                            "type": "number"
                                        },
                                        "inter_delay": {
                                            "type": "number"
                                        },
                                        "step": {
                                            "type": "number"
                                        },
                                        "offset": {
                                            "type": "number"
                                        },
                                        "limits": {
                                            "type": [
                                                "array",
                                                "string"
                                            ],
                                            "items": [
                                                {
                                                    "type": "number"
                                                },
                                                {
                                                    "type": "number"
                                                }
                                            ],
                                            "minItems": 2,
                                            "maxItems": 2,
                                            "additionalItems": false
                                        },
                                        "initial_value": {},
                                        "monitor": {
                                            "type": "boolean"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "additionalProperties": false
                        },
                        "parameters": {
                            "type": "object",
                            "patternProperties": {
                                "^(\\w+(\\[\\d+\\])*)(\\.\\w+(\\[\\d+\\])*)*$": {
                                    "$ref": "#/definitions/parameter_settings"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": {
                        "$ref": "#/definitions/component_settings"
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
